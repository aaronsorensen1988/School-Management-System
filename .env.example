# copy to .env and fill in. don't commit the real one.
#
# make a key with:
#   python -c "from security.keys import generate_key; print(generate_key())"

# "id:base64key", comma separated. keeping an old key here is what lets
# rows written before a rotation still be read.
SMS_ENCRYPTION_KEYS=k1:replace-me

# which key new writes use. optional if there's only one.
SMS_ENCRYPTION_ACTIVE_KEY=k1

# separate key for blind index tokens. derived from the main key if you
# leave it off, which is fine locally. set it for real deployments.
# SMS_BLIND_INDEX_KEY=

# defaults to a local sqlite file
# SMS_DATABASE_URL=sqlite:///sms.db
